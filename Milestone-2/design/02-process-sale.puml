@startuml
actor Salesperson as A
boundary Workbench as UI
control PearlMartFacade as F
control CheckoutService as C
control StockService as S
participant "PricingPolicy / RatePolicy" as P
database Ledger as L
A -> UI : open checkout
UI -> F : start()
F -> C : start()
C -> L : commit(pending sale state)
loop each requested item
 A -> UI : ID/barcode + quantity
 UI -> F : addLine(id,key,q)
 F -> C : addLine(id,key,q)
 C -> S : find(key)
 S -> L : snapshot()
 S --> C : item or empty
 alt unknown/invalid/insufficient (UC14)
 C --> F : validation error
 F --> UI : reject line; stock unchanged
 else valid
 C -> L : commit(updated pending lines)
 C --> F : Sale (price snapshot)
 F --> UI : update basket
 end
end
UI -> F : quote(id) [UC15]
F -> C : quote(id)
C -> P : calculate(lines) [UC16]
alt invalid/empty calculation
 P --> C : error
 C --> F : error
 F --> UI : block confirmation
else valid
 P --> C : Totals
 C --> F : Totals
 F --> UI : show subtotal/discount/tax/total
end
alt cancellation requested (UC17)
 A -> UI : Cancel; confirm dialog
 alt declines
 UI --> A : pending retained
 else accepts
 UI -> F : cancel(id)
 F -> C : cancel(id)
 C -> L : commit(cancelled sale; same items)
 C --> F : cancelled Sale or error
 F --> UI : show cancellation or failure
 end
else confirm pending sale
 A -> UI : Confirm & issue receipt
 UI -> F : confirm(id)
 F -> C : confirm(id)
 C -> P : calculate(lines)
 C -> L : snapshot()
 C -> C : recheck all quantities; stage movements + receipt
 alt invalid stock/policy/status or commit failure
 C --> F : reject; no partial update
 F --> UI : display error
 else valid
 C -> L : commit(stock, movements, completed sale)
 C --> F : SalesReceipt
 F --> UI : show receipt; updated inventory
 end
end
@enduml
